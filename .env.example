# ─── Network ──────────────────────────────────────────────────────────────────
# Which network the app targets: "testnet" (default), "mainnet" or "sepolia".
NEXT_PUBLIC_CHAIN=testnet

# Robinhood Chain mainnet. Chain id 4663 (0x1237), ETH for gas.
NEXT_PUBLIC_MAINNET_CHAIN_ID=4663
NEXT_PUBLIC_MAINNET_NAME=Robinhood Chain
NEXT_PUBLIC_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_MAINNET_EXPLORER_NAME=Blockscout
NEXT_PUBLIC_MAINNET_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Ethereum Sepolia — the target of the Foundry contracts in contracts/.
# Set NEXT_PUBLIC_CHAIN=sepolia to point the UI here.
NEXT_PUBLIC_SEPOLIA_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_NAME=Ethereum Sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_EXPLORER_NAME=Etherscan
NEXT_PUBLIC_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io

# Robinhood Chain testnet. Chain id 46630 (0xb626).
NEXT_PUBLIC_TESTNET_CHAIN_ID=46630
NEXT_PUBLIC_TESTNET_NAME=Robinhood Chain Testnet
NEXT_PUBLIC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_TESTNET_EXPLORER_NAME=Robinhood Testnet Explorer
NEXT_PUBLIC_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Native gas token, shown throughout the UI.
NEXT_PUBLIC_NATIVE_SYMBOL=ETH
NEXT_PUBLIC_NATIVE_NAME=Ether

# ─── Contracts ────────────────────────────────────────────────────────────────
# MemeFactory. Deploy it once with `npm run deploy:factory` and paste the
# address here — this is what makes launches globally discoverable. Leave it
# blank to run without one: launches still work, but only the browser that
# created a coin will list it.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Uniswap V2 router. Curve launches graduate into a pool through this, and the
# liquidity page uses it. Leave blank if the chain has no V2 deployment: curves
# then keep trading past their target instead of stranding the raise.
NEXT_PUBLIC_ROUTER_ADDRESS=

# Where launch fees go when a coin is deployed without a factory. Defaults to
# the creator's own wallet.
NEXT_PUBLIC_TREASURY_ADDRESS=

# LaunchpadToken (contracts/src/LaunchpadToken.sol), once deployed to Sepolia.
# Printed by `forge script script/DeployToken.s.sol:DeployToken`.
NEXT_PUBLIC_LAUNCHPAD_TOKEN_ADDRESS=

# MerkleAirdrop (contracts/src/MerkleAirdrop.sol), once deployed.
# Printed by `forge script script/DeployAirdrop.s.sol:DeployAirdrop`.
# See docs/03-airdrop.md.
NEXT_PUBLIC_AIRDROP_ADDRESS=

# ─── Indexing ─────────────────────────────────────────────────────────────────
# Reads are batched over JSON-RPC rather than through an on-chain aggregator,
# so no third-party contract sits between the app and the data it shows. This
# caps how many calls ride in a single HTTP request.
NEXT_PUBLIC_RPC_BATCH_SIZE=20

# Blocks per eth_getLogs window. Public RPCs cap the range; lower this if the
# trade feed comes back empty.
NEXT_PUBLIC_LOG_CHUNK=9000

# How far back the trade feed scans for a coin with no known launch block.
NEXT_PUBLIC_TRADE_LOOKBACK=200000

# ─── Display ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=Hoodpad

# Optional ETH/USD rate. Set it to show approximate dollar values next to
# market caps; leave blank to show ETH only.
NEXT_PUBLIC_ETH_USD=

# ─── Scripts (server side, never exposed to the browser) ──────────────────────
# Private key used by `npm run deploy:factory`. Never commit a funded key.
DEPLOYER_KEY=
