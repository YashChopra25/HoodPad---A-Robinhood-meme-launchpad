# ─── Deployment ───────────────────────────────────────────────────────────────
# Private key of the deploying account, 0x-prefixed.
# Use a throwaway key that only ever holds testnet funds. Never commit this
# file with a real value: .gitignore excludes .env but not .env.example.
PRIVATE_KEY=

# JSON-RPC endpoint for Sepolia. Any provider works — Alchemy, Infura, dRPC,
# or your own node.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ─── Verification ─────────────────────────────────────────────────────────────
# Etherscan API key, used by `forge verify-contract` and `--verify`.
# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ─── Token parameters ─────────────────────────────────────────────────────────
# Initial supply in whole tokens; the script scales it by 1e18.
INITIAL_SUPPLY=1000000

# ─── Safety ───────────────────────────────────────────────────────────────────
# The chain id the deploy script insists on. 11155111 = Sepolia, 31337 = Anvil.
# The script reverts if the RPC it is pointed at reports anything else, so a
# wrong --rpc-url fails before a transaction is ever signed.
EXPECTED_CHAIN_ID=11155111

# Ethereum mainnet is refused outright unless this is set to true. Leave it
# unset for every testnet deployment.
ALLOW_MAINNET=
