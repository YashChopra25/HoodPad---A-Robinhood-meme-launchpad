{
  "name": "Hoodpad-A Robinhood lauchpad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "compile": "node scripts/compile-contracts.mjs",
    "compile:foundry": "node scripts/export-foundry-abi.mjs",
    "compile:all": "npm run compile && npm run compile:foundry",
    "test": "node scripts/contract-test.mjs",
    "test:airdrop": "node scripts/airdrop-parity-test.mjs",
    "test:foundry": "cd contracts && forge test",
    "test:all": "npm run test && npm run test:airdrop && npm run test:foundry",
    "airdrop:build": "node scripts/build-merkle.mjs",
    "deploy:factory": "node scripts/deploy-factory.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.28",
    "solc": "^0.8.36",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}